#include <string>
using namespace std;
class Student {
protected:
    string name;
    string rollno;
    string address;
public:
    void getdata() 
    {
        cout << "Enter name: ";
        getline(cin, name);
        cout << "Enter roll number: ";
        getline(cin, rollno);
        cout << "Enter address: ";
        getline(cin, address);
    }
};
class Marks : public Student {
private:
    float sub1, sub2, sub3;
    float total;
    float average;
public:
    void inputmarks() {
        cout << "Enter marks for 3 subjects:" << endl;
        cout << "Subject 1: ";
        cin >> sub1;
        cout << "Subject 2: ";
        cin >> sub2;
        cout << "Subject 3: ";
        cin >> sub3;
        total = sub1 + sub2 + sub3;
        average = total / 3.0;
    }
    void showdetail() {
        cout << "Student Detail" << endl;
        cout << "Name: " << name << endl;
        cout << "Roll No: " << rollno << endl;
        cout << "Address: " << address << endl;
        cout << "Marks" << endl;
        cout << "Subject 1: " << sub1 << endl;
        cout << "Subject 2: " << sub2 << endl;
        cout << "Subject 3: " << sub3 << endl;
        cout << "Total Marks: " << total << endl;
        cout << "Average Marks: " << average << endl;
    }
};
int main() {
    Marks student1;
    student1.getdata();
    student1.inputmarks();
    student1.showdetail();
    return 0;
}
